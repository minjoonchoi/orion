# Browser-visible URL only. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Absolute Orion API URL that starts OIDC and responds with a redirect to Okta.
# Configure the actual backend endpoint; this is an example, not an implemented API.
# Server-side runtime setting. Prefer HTTPS in deployed environments.
# ORION_AUTH_LOGIN_URL=http://localhost:8080/api/auth/login
