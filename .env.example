# Runtime server settings; the same build can be promoted across deployments.
ORION_DATA_SOURCE=demo
ORION_ENVIRONMENT=development
ORION_REGION=local
ORION_DEFAULT_LOCALE=ko
ORION_TIME_ZONE=Asia/Seoul
ORION_API_TIMEOUT_MS=10000

# Required in api mode; include the API prefix. No NEXT_PUBLIC host is used.
# ORION_API_BASE_URL=http://localhost:8080/api/v1
# ORION_AUTH_LOGIN_URL=http://localhost:8080/auth/login
# Forward only this session cookie to the trusted API, when required.
# ORION_SESSION_COOKIE=orion_session

# Optional deployment map; explicit URLs above take precedence.
# ORION_API_ENDPOINTS_JSON={"production":{"ap-northeast-2":{"baseUrl":"https://api.kr.example.test/v1","loginUrl":"https://api.kr.example.test/auth/login"},"us-east-1":{"baseUrl":"https://api.us.example.test/v1","loginUrl":"https://api.us.example.test/auth/login"}},"staging":{"ap-northeast-2":{"baseUrl":"https://api.staging.kr.example.test/v1","loginUrl":"https://api.staging.kr.example.test/auth/login"}}}
